# big_head is tuned for a fixed 1 ms control period. Other periods require retuning.
config_integer(_app_control_period_ms 1 1 application big_head control_period_ms)
foreach(_thread IN ITEMS control usb)
    config_integer(_app_${_thread}_priority 1 31 application big_head ${_thread}_priority)
    config_integer(_app_${_thread}_stack_size 2048 32768 application big_head ${_thread}_stack_size)
endforeach()
config_integer(_app_usb_period_ms 1 100 application big_head usb_period_ms)
config_integer(_app_usb_write_timeout_ms 1 60000 application big_head usb_write_timeout_ms)
config_integer(_app_vt03_baud_rate 1200 3000000 application big_head vt03_baud_rate)
foreach(_timeout IN ITEMS imu vision lower motor)
    config_integer(_app_${_timeout}_timeout_ms 1 60000 application big_head ${_timeout}_timeout_ms)
endforeach()
config_integer(_app_recovery_period_ms 1 60000 application big_head recovery_period_ms)
config_integer(_app_auto_fire_timeout_ms 1 60000 application big_head auto_fire_timeout_ms)

# DJI feedback IDs share one physical bus and must be unique.
config_integer(_app_pitch_id 517 520 application big_head pitch_id)
foreach(_side IN ITEMS left right)
    config_integer(_app_friction_${_side}_id 513 520 application big_head friction_${_side}_id)
endforeach()
if(_app_pitch_id EQUAL _app_friction_left_id OR
   _app_pitch_id EQUAL _app_friction_right_id OR
   _app_friction_left_id EQUAL _app_friction_right_id)
    message(FATAL_ERROR "application.big_head: motor feedback IDs must be unique")
endif()
math(EXPR _app_pitch_id_hex "${_app_pitch_id}" OUTPUT_FORMAT HEXADECIMAL)
math(EXPR _app_friction_left_id_hex "${_app_friction_left_id}" OUTPUT_FORMAT HEXADECIMAL)
math(EXPR _app_friction_right_id_hex "${_app_friction_right_id}" OUTPUT_FORMAT HEXADECIMAL)

# PID tuples: kp, ki, kd, max_out, max_iout. Gains include the 1 ms sample period.
foreach(_pid IN ITEMS yaw_position yaw_velocity pitch_position pitch_velocity friction_velocity)
    config_float_array(_app_${_pid}_pid 5 0 50000 application big_head ${_pid}_pid)
    config_number(_pid_max 0.001 50000 application big_head ${_pid}_pid 3)
    config_number(_pid_imax 0 ${_pid_max} application big_head ${_pid}_pid 4)
endforeach()
config_number(_friction_max 0.001 16384 application big_head friction_velocity_pid 3)
config_float(_app_yaw_current_limit 0.001 32767 application big_head yaw_current_limit)
config_float(_app_pitch_current_limit 0.001 15000 application big_head pitch_current_limit)
config_float(_app_pitch_current_scale 0.001 1000 application big_head pitch_current_scale)
config_float(_app_pitch_gravity_manual -15000 15000 application big_head pitch_gravity_manual)
config_float(_app_pitch_gravity_auto -15000 15000 application big_head pitch_gravity_auto)

# Angles are radians; speed is rad/s at the configured friction output shaft.
config_float(_app_pitch_min -1.570796 1.570796 application big_head pitch_min)
config_float(_app_pitch_max -1.570796 1.570796 application big_head pitch_max)
config_number(_pitch_min -1.570796 1.570796 application big_head pitch_min)
config_number(_pitch_max -1.570796 1.570796 application big_head pitch_max)
if(_pitch_min GREATER_EQUAL _pitch_max)
    message(FATAL_ERROR "application.big_head: pitch_min must be less than pitch_max")
endif()
config_float(_app_manual_deadband 0 0.99 application big_head manual_deadband)
config_float(_app_manual_angle_scale 0 1 application big_head manual_angle_scale)
config_float(_app_mouse_yaw_scale 0 1 application big_head mouse_yaw_scale)
config_float(_app_mouse_pitch_scale 0 1 application big_head mouse_pitch_scale)
config_float(_app_keyboard_slew_per_tick 0.000001 1 application big_head keyboard_slew_per_tick)
config_float(_app_friction_speed 0.001 3000 application big_head friction_speed)
config_float(_app_friction_ready_ratio 0.001 1 application big_head friction_ready_ratio)
config_float(_app_friction_drop 0.001 3000 application big_head friction_drop)
config_float(_app_heat_fraction 0.001 1 application big_head heat_fraction)
config_float(_app_fire_angle_tolerance 0.000001 0.5 application big_head fire_angle_tolerance)

# The lower-controller wire field stores signed integer speeds (rad/s).
foreach(_speed IN ITEMS low high continuous)
    config_integer(_trigger_${_speed} 0 127 application big_head trigger_${_speed})
endforeach()
config_number(_trigger_reverse -128 0 application big_head trigger_reverse)
if(NOT _trigger_reverse MATCHES "^-?[0-9]+$")
    message(FATAL_ERROR "application.big_head.trigger_reverse: expected an integer")
endif()
foreach(_flag IN ITEMS auto_aim auto_shoot gimbal_only)
    config_bool(_app_${_flag}_default application big_head ${_flag}_default)
endforeach()

# Feedforward tuples: prediction seconds, inertia, damping, command/torque scale.
foreach(_axis IN ITEMS yaw pitch)
    config_float_array(_app_${_axis}_feedforward 4 0 1000 application big_head ${_axis}_feedforward)
    config_number(_prediction 0 0.1 application big_head ${_axis}_feedforward 0)
endforeach()
# Scalar Kalman filter tuples: process noise Q and measurement noise R (> 0).
foreach(_filter IN ITEMS manual_yaw manual_pitch vision)
    config_float_array(_app_${_filter}_filter 2 0 1000 application big_head ${_filter}_filter)
    config_number(_filter_r 0.000000001 1000 application big_head ${_filter}_filter 1)
endforeach()
