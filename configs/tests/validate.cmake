cmake_minimum_required(VERSION 3.22)

# Each case validates an in-memory JSON copy; the user's JSON/header are never written.
get_filename_component(_config_dir "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(DEFINED TEST_CASE)
    file(READ "${_config_dir}/user_config.json" _json)
    if(TEST_CASE STREQUAL "unsupported_can")
        string(JSON _json SET "${_json}" boards h723_mc02 dmimu_can "\"can1\"")
    elseif(TEST_CASE STREQUAL "referee_conflict")
        string(JSON _json SET "${_json}" boards h723_mc02 referee_uart "\"uart5\"")
    elseif(NOT TEST_CASE STREQUAL "h723_mc02" AND NOT TEST_CASE STREQUAL "f407_cboard")
        message(FATAL_ERROR "Unknown test case: ${TEST_CASE}")
    endif()

    set(BOARD "${TEST_CASE}")
    include("${_config_dir}/scripts/values.cmake")
    include("${_config_dir}/scripts/communication.cmake")
    include("${_config_dir}/scripts/imu.cmake")
    include("${_config_dir}/scripts/boards.cmake")
    return()
endif()

foreach(_case IN ITEMS h723_mc02 f407_cboard unsupported_can referee_conflict)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DTEST_CASE=${_case}"
        -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
    if(_case STREQUAL "h723_mc02" OR _case STREQUAL "f407_cboard")
        if(NOT _result EQUAL 0)
            message(FATAL_ERROR "${_case} unexpectedly failed:\n${_output}${_error}")
        endif()
    elseif(_result EQUAL 0)
        message(FATAL_ERROR "${_case} unexpectedly passed")
    endif()
endforeach()
message(STATUS "Configuration validation: 2 valid boards and 2 invalid cases passed")
