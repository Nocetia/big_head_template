cmake_minimum_required(VERSION 3.22)

# Each case validates an in-memory JSON copy; the user's JSON/header are never written.
get_filename_component(_config_dir "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(DEFINED TEST_CASE)
    file(READ "${_config_dir}/user_config.json" _json)
    if(TEST_CASE STREQUAL "can_conflict")
        string(JSON _json SET "${_json}" boards h723_mc02 lower_can "\"fdcan1\"")
    elseif(TEST_CASE STREQUAL "unsupported_can")
        string(JSON _json SET "${_json}" boards h723_mc02 motor_can "\"can1\"")
    elseif(TEST_CASE STREQUAL "duplicate_motor")
        string(JSON _json SET "${_json}" application big_head friction_right_id "513")
    elseif(TEST_CASE STREQUAL "wrong_period")
        string(JSON _json SET "${_json}" application big_head control_period_ms "2")
    elseif(TEST_CASE STREQUAL "pid_shape")
        string(JSON _json SET "${_json}" application big_head pitch_position_pid "[80, 0, 800]")
    elseif(TEST_CASE STREQUAL "pitch_current")
        string(JSON _json SET "${_json}" application big_head pitch_current_limit "15001")
    elseif(TEST_CASE STREQUAL "pitch_range")
        string(JSON _json SET "${_json}" application big_head pitch_min "0.5")
    elseif(TEST_CASE STREQUAL "filter_noise")
        string(JSON _json SET "${_json}" application big_head vision_filter "[0.001, 0]")
    elseif(TEST_CASE STREQUAL "vt03_disabled")
        string(JSON _json SET "${_json}" boards h723_mc02 remoter_vt03_enabled "false")
    elseif(TEST_CASE STREQUAL "referee_conflict")
        string(JSON _json SET "${_json}" boards h723_mc02 referee_uart "\"usart1\"")
    elseif(TEST_CASE STREQUAL "wrong_imu")
        string(JSON _json SET "${_json}" boards h723_mc02 ahrs_device "\"dmimu\"")
    elseif(TEST_CASE STREQUAL "fractional_trigger")
        string(JSON _json SET "${_json}" application big_head trigger_reverse "-8.5")
    elseif(TEST_CASE STREQUAL "usb_disabled")
        string(JSON _json SET "${_json}" usb enabled "false")
    elseif(NOT TEST_CASE STREQUAL "h723_mc02" AND NOT TEST_CASE STREQUAL "f407_cboard")
        message(FATAL_ERROR "Unknown test case: ${TEST_CASE}")
    endif()

    set(BOARD "${TEST_CASE}")
    include("${_config_dir}/scripts/values.cmake")
    include("${_config_dir}/scripts/communication.cmake")
    include("${_config_dir}/scripts/application.cmake")
    include("${_config_dir}/scripts/boards.cmake")
    if(TEST_CASE STREQUAL "h723_mc02" AND NOT USER_BIG_HEAD_APP EQUAL 1)
        message(FATAL_ERROR "H723 app must be enabled")
    endif()
    if(TEST_CASE STREQUAL "f407_cboard" AND NOT USER_BIG_HEAD_APP EQUAL 0)
        message(FATAL_ERROR "F407 app must remain disabled")
    endif()
    return()
endif()

foreach(_case IN ITEMS h723_mc02 f407_cboard can_conflict unsupported_can duplicate_motor
        wrong_period pid_shape pitch_current pitch_range filter_noise vt03_disabled
        referee_conflict wrong_imu fractional_trigger usb_disabled)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DTEST_CASE=${_case}"
        -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
    if(_case STREQUAL "h723_mc02" OR _case STREQUAL "f407_cboard")
        if(NOT _result EQUAL 0)
            message(FATAL_ERROR "${_case} unexpectedly failed:\n${_output}${_error}")
        endif()
    elseif(_result EQUAL 0)
        message(FATAL_ERROR "${_case} unexpectedly passed")
    endif()
endforeach()
message(STATUS "Configuration validation: 2 valid boards and 13 invalid cases passed")
